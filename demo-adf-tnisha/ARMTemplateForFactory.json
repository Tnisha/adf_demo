		{
			"name": "[concat(parameters('factoryName'), '/PL_FOREACH_DEMO')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Ingest All Tables",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Read List of Tables",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Read List of Tables').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"activities": [
								{
									"name": "Execute Ingestion Pipeline",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_DEMO_INGESTION",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"table_name": {
												"value": "@item().table_name",
												"type": "Expression"
											}
										}
									}
								},
								{
									"name": "Store Table success",
									"type": "AppendVariable",
									"dependsOn": [
										{
											"activity": "Execute Ingestion Pipeline",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"variableName": "table_status",
										"value": {
											"value": "@{item().table_name} - SUCCESS",
											"type": "Expression"
										}
									}
								},
								{
									"name": "Store Table Failure",
									"type": "AppendVariable",
									"dependsOn": [
										{
											"activity": "Execute Ingestion Pipeline",
											"dependencyConditions": [
												"Failed"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"variableName": "table_status",
										"value": {
											"value": "@{item().table_name} - FAILURE",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
					{
						"name": "Read List of Tables",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT table_name from metadata.table_list",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_SERVER",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"table_name": "customers"
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "Send Consolidated Email",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "Ingest All Tables",
