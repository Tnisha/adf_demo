				},
				"parameters": {
					"table_name": {
						"type": "string"
					},
					"status": {
						"type": "string"
					},
					"email_recepient": {
						"type": "string"
					}
				},
				"variables": {
					"Logic_apps_body": {
						"type": "String"
					},
					"Logic_apps_subject": {
						"type": "String"
					},
					"Email_body": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-13T18:22:25Z"
			},
			"dependsOn": []
		},
